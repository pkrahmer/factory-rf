{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-records-contract": "4.3",
  "$defs": {
    "MachineMeasures": {
      "additionalProperties": false,
      "description": "The machine around one run; a measure `None` is unknown.\n\nThe image sizes are those of the image the run ran in, measured when it was built or\nchosen. The memory peak is the user slice's high-water mark since it began, not the run's.\nThe CPU time and the waits are the run's own, but count every container of the user.",
      "properties": {
        "base_image_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Image Bytes"
        },
        "project_layer_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Layer Bytes"
        },
        "store_free_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Store Free Bytes"
        },
        "dataset_free_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Free Bytes"
        },
        "memory_peak_since_boot_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Peak Since Boot Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Total Bytes"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        },
        "cpu_wait_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Wait Seconds"
        },
        "memory_wait_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Wait Seconds"
        }
      },
      "title": "MachineMeasures",
      "type": "object"
    },
    "TokenCounts": {
      "additionalProperties": false,
      "description": "The tokens one run used, by kind.",
      "properties": {
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "cache_read": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read",
          "type": "integer"
        },
        "cache_creation": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation",
          "type": "integer"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "TokenCounts",
      "type": "object"
    },
    "TranscriptRef": {
      "additionalProperties": false,
      "description": "Where a run's transcript was kept and what it held when written.\n\n`path` is relative to the transcript folder, `<work item>/<run id>.<ext>.gz`; `sha256` is\nthe SHA-256 of the file as written, so a reader can tell it is the file the record names.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "TranscriptRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One agent run: started, or completed with its measures; a measure `None` is unknown.\n\n`image` and `instance` say where the run ran: the machine's image and the name of\nthe instance; either may be `None` on a record written without settings.\n`denials` counts the tool calls the runtime reported as refused and `denied_paths`\nholds the files they named, each once; both are `None` when the runtime gave no reply.\n`login` says which login the run's calls were handed: an API key, the subscription's\ntoken, or neither; it is `None` when the runtime had no login file.\n`machine` holds the machine's measures; it is `None` on a record written without them,\nand each of its measures is `None` when the machine could not give it.\n`transcript` names the run's kept transcript; it is `None` when none was kept.",
  "properties": {
    "run": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Run",
      "type": "string"
    },
    "work_item": {
      "pattern": "^F\\d{4}-[SA]\\d{4}$",
      "title": "Work Item",
      "type": "string"
    },
    "stage": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Stage",
      "type": "string"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Role",
      "type": "string"
    },
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "status": {
      "enum": [
        "started",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "model_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Seconds"
    },
    "end_reason": {
      "anyOf": [
        {
          "enum": [
            "completed",
            "no_result",
            "time_limit",
            "budget",
            "died",
            "provider_limit"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Reason"
    },
    "turns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turns"
    },
    "tokens": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image"
    },
    "instance": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instance"
    },
    "denials": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denials"
    },
    "denied_paths": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denied Paths"
    },
    "transcript": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "machine": {
      "anyOf": [
        {
          "$ref": "#/$defs/MachineMeasures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "login": {
      "anyOf": [
        {
          "enum": [
            "api_key",
            "subscription",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Login"
    }
  },
  "required": [
    "run",
    "work_item",
    "stage",
    "role",
    "attempt",
    "status",
    "started_at"
  ],
  "title": "CostRecord",
  "type": "object"
}
