# The operator's site file: the values that belong to one site, read by the operator's scripts.
# Copy it with `site init`, keep it outside every repository, and fill in your own values.
# Lines are SITE_NAME=value; a value is taken literally and never executed.

# The factory's repository on the hosting service, as owner/repo. Required.
SITE_REPOSITORY=owner/repo
# The local checkout of that repository. Required.
SITE_CHECKOUT=/path/to/checkout
# The hosting service's API. Optional; the default is GitHub's public API.
SITE_API_URL=https://api.example.invalid
# The command that prints a token for the hosting service. Optional; the default is `gh auth token`.
SITE_TOKEN_CMD=/path/to/token-command
# The proxy through which the job and its tools reach the network. Optional; the default is no proxy.
SITE_PROXY=http://proxy.example.invalid:3128
# The hosts reached without the proxy, comma-separated. Optional; the default is none.
SITE_NO_PROXY=localhost,192.0.2.10
# The cloud project the job runs in. Required for a job.
SITE_PROJECT=example-project
# The cloud region of the job. Required for a job.
SITE_REGION=example-region1
# The service account the operator's cloud commands impersonate. Optional; the default is your own login.
SITE_IMPERSONATE=operator@example-project.example.invalid
# The service account the job runs as. Required for a job.
SITE_RUN_AS=job@example-project.example.invalid
# The network connector the job's traffic leaves through. Required for a job.
SITE_CONNECTOR=example-connector
# The name of the job. Required for a job.
SITE_JOB=example-factory
# The factory instance's name in the job. Optional; the default is the job's name.
SITE_INSTANCE=example-instance
# The clone URL of the factory's repository. Required for a job.
SITE_REPOSITORY_URL=https://git.example.invalid/owner/repo.git
# The clone URL of the factory's own code. Required for a job.
SITE_CODE_URL=https://git.example.invalid/owner/code.git
# The branch or tag of the factory's code the job runs. Optional; the default is main.
SITE_CODE_REF=main
# The name of the secret that holds the hosting service's token. Required for a job.
SITE_HOSTING_SECRET=example-hosting-token
# The name of the secret that holds the model provider's key. Required for a job.
SITE_MODEL_SECRET=example-model-key
# The model provider's API. Optional; the default is the provider's public API.
SITE_MODEL_BASE_URL=https://models.example.invalid/v1
# The model the agents run on. Required for a job.
SITE_MODEL=example-model
# The model's price per million input tokens, in dollars. Optional; the default is no cost record.
SITE_MODEL_INPUT_COST=1.00
# The model's price per million output tokens, in dollars. Optional; the default is no cost record.
SITE_MODEL_OUTPUT_COST=5.00
# The login service that issues the model provider's tokens. Optional; the default is no login.
SITE_LOGIN_URL=https://login.example.invalid/oauth2/token
# The scope asked of the login service. Optional; the default is none.
SITE_LOGIN_SCOPE=example-scope
# The client id given to the login service. Optional; the default is none.
SITE_LOGIN_CLIENT_ID=example-client-id
# The job's CPUs. Optional; the default is 4.
SITE_CPU=4
# The job's memory. Optional; the default is 16Gi.
SITE_MEMORY=16Gi
# The job's task timeout. Optional; the default is 24h.
SITE_TIMEOUT=24h
# The idle minutes after which the job ends itself. Optional; the default is 30.
SITE_IDLE_MINUTES=30
# The repository a trial resets to a clean state, as owner/repo. Optional; the default is none.
SITE_RESET_REPOSITORY=owner/trial-repo
# The file of rules that sanitise what leaves the site. Optional; the default is none.
SITE_SANITISE_RULES=/path/to/sanitise-rules
