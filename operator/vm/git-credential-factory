#!/bin/sh
# Git's credential helper: the hosting-service token from the file FACTORY_TOKEN_FILE names.
# Only a user who can read that file gets a credential; anyone else gets nothing. With
# FACTORY_REPOSITORY_URL set, only a request for that URL's host gets it, so the project's
# token never reaches the host of the factory's code or any other.
set -u

operation="${1:-}"
# Git writes its request on standard input; read it all so git never sees a closed pipe.
request=$(cat)

lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# https://[user@]host[:port]/..., ssh://[user@]host[:port]/... or [user@]host:path.
url_host() {
  case "$1" in
    *://*)
      host=${1#*://}
      host=${host%%/*}
      host=${host##*@}
      host=${host%%:*}
      ;;
    *)
      host=${1%%:*}
      host=${host##*@}
      ;;
  esac
  lower "$host"
}

requested_host() {
  host=$(printf '%s\n' "$request" | sed -n 's/^host=//p' | head -n 1)
  lower "${host%%:*}"
}

if [ "$operation" != "get" ]; then
    exit 0
fi
if [ -z "${FACTORY_TOKEN_FILE:-}" ] || [ ! -r "$FACTORY_TOKEN_FILE" ]; then
    exit 1
fi
if [ -n "${FACTORY_REPOSITORY_URL:-}" ]; then
    asked=$(requested_host)
    if [ -z "$asked" ] || [ "$asked" != "$(url_host "$FACTORY_REPOSITORY_URL")" ]; then
        exit 1
    fi
fi
value=$(cat "$FACTORY_TOKEN_FILE") || exit 1
printf '%s=%s\n' username x-access-token
printf '%s=%s\n' password "$value"
