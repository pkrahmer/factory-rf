#!/bin/sh
# Git's credential helper: the hosting-service token from the file FACTORY_TOKEN_FILE names.
# Only a user who can read that file gets a credential; anyone else gets nothing.
set -u

operation="${1:-}"
# Git writes its request on standard input; read it all so git never sees a closed pipe.
cat > /dev/null

if [ "$operation" != "get" ]; then
    exit 0
fi
if [ -z "${FACTORY_TOKEN_FILE:-}" ] || [ ! -r "$FACTORY_TOKEN_FILE" ]; then
    exit 1
fi
value=$(cat "$FACTORY_TOKEN_FILE") || exit 1
printf '%s=%s\n' username x-access-token
printf '%s=%s\n' password "$value"
